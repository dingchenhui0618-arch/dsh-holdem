{
  "name": "dsh-poker-night",
  "version": "0.5.0",
  "description": "No-Limit Hold'em night table for DeepSeek Harness: one human, LLM founders, and LAN friends.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test test/*.test.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-poker-night.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-poker-night",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-poker-night/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "texas-holdem",
    "poker",
    "multiplayer",
    "lan"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.5"
  }
}
